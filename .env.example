# Copy to .env and fill in. .env is gitignored, never commit real values.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username without @, e.g. my_words_bot
TELEGRAM_BOT_USERNAME=

# OpenAI API key from https://platform.openai.com/api-keys (main LLM provider)
OPENAI_API_KEY=

# Claude API key from https://console.anthropic.com (fallback when OpenAI fails);
# create it inside a workspace
ANTHROPIC_API_KEY=

# PostgreSQL (used by docker-compose and the app; defaults shown).
# 5433, not 5432: avoids a clash with a locally installed PostgreSQL.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=words
DB_USER=words
DB_PASSWORD=words
